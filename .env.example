# ---------------------------------------------------------------------------
# Duel.uz environment
# Copy to .env  ->  `node scripts/setup-env.mjs` generates real secrets for you
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin of the app (used for canonical URLs, OG images, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Duel.uz

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://dueluz:dueluz@localhost:5434/dueluz?schema=public
# Separate database used by `pnpm test:integration` (it is TRUNCATEd between tests)
TEST_DATABASE_URL=postgresql://dueluz:dueluz@localhost:5434/dueluz_test?schema=public

# --- Redis (optional) ------------------------------------------------------
# Leave empty to fall back to an in-process limiter/cache (fine for local dev,
# NOT safe for multi-instance production).
REDIS_URL=redis://localhost:6380

# --- Secrets (min 32 chars each, NEVER commit real values) -----------------
SESSION_SECRET=replace-me-with-32+-random-characters-000
ANON_SECRET=replace-me-with-32+-random-characters-111
IP_SALT=replace-me-with-32+-random-characters-222

# --- Storage ---------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
# local driver
LOCAL_STORAGE_DIR=./apps/web/public/uploads
LOCAL_STORAGE_PUBLIC_PATH=/uploads
# s3 driver (S3, Cloudflare R2, MinIO, ...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# --- Moderation / limits ---------------------------------------------------
# Comma separated emails that are promoted to ADMIN on seed
SEED_ADMIN_EMAIL=admin@duel.uz
SEED_ADMIN_PASSWORD=Admin123!duel
