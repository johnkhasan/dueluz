# ---------------------------------------------------------------------------
# Duel.uz environment
# Copy to .env  ->  `node scripts/setup-env.mjs` generates real secrets for you
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin of the app (used for canonical URLs, OG images, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Duel.uz

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://dueluz:dueluz@localhost:5434/dueluz?schema=public
# Separate database used by `pnpm test:integration` (it is TRUNCATEd between tests)
TEST_DATABASE_URL=postgresql://dueluz:dueluz@localhost:5434/dueluz_test?schema=public

# --- Redis (optional) ------------------------------------------------------
# Leave empty to fall back to an in-process limiter/cache (fine for local dev,
# NOT safe for multi-instance production).
REDIS_URL=redis://localhost:6380

# --- Secrets (min 32 chars each, NEVER commit real values) -----------------
SESSION_SECRET=replace-me-with-32+-random-characters-000
ANON_SECRET=replace-me-with-32+-random-characters-111
IP_SALT=replace-me-with-32+-random-characters-222

# --- Storage ---------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
# local driver
LOCAL_STORAGE_DIR=./public/uploads
LOCAL_STORAGE_PUBLIC_PATH=/uploads
# s3 driver (S3, Cloudflare R2, MinIO, ...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# --- Telegram login --------------------------------------------------------
# Sign-in is Telegram-only. Create a bot with @BotFather, then:
#   /newbot          -> gives you the token below and the bot's @username
#   /setdomain       -> point it at NEXT_PUBLIC_APP_URL's host, or the Login
#                       Widget refuses to render (localhost is not accepted —
#                       use a tunnel such as ngrok for local testing)
# The token is the HMAC key that proves a login payload really came from
# Telegram. Treat it exactly like a signing secret.
TELEGRAM_BOT_TOKEN=
# Bot username without the leading @ (e.g. dueluz_bot). Shipped to the browser.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Moderation / limits ---------------------------------------------------
# Numeric Telegram id promoted to ADMIN on seed (get yours from @userinfobot)
SEED_ADMIN_TELEGRAM_ID=
