# ---------------------------------------------------------------------------
# Duel.uz production environment (lives at /srv/dueluz/.env on the server).
# Secrets are generated on first deploy; never commit the real file.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=https://duel.hsbch.uz
NEXT_PUBLIC_APP_NAME=Duel.uz

# Database password for the project-private Postgres container.
POSTGRES_PASSWORD=

# Minimum 32 characters each.
SESSION_SECRET=
ANON_SECRET=
IP_SALT=

# --- Telegram sign-in ------------------------------------------------------
# From @BotFather. The bot's domain must also be set to the host above
# (/setdomain), or the login widget refuses to load.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Telegram id that the seeded admin account is claimed by (@userinfobot).
SEED_ADMIN_TELEGRAM_ID=
